apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: @@application@@
  namespace: argocd
spec:
  project: default
  source:
    repoURL: "@@repository@@"
    targetRevision: "@@branch@@"
    path: deploy/production
  destination:
    server: https://kubernetes.default.svc
    namespace: @@namespace@@
  revisionHistoryLimit: 5
